.venv/
__pycache__/
.ipynb_checkpoints/
.env

# Raw API dumps duplicate the snapshot CSVs and are large; keep local
data/raw/**/*.json
# Epoch texts are already merged into data/processed/epoch_history.csv
data/external/epoch/*/frontier_lab_hiring_posting_texts.csv

# Full corpus cache (30 MB binary, rebuilt from data/processed/corpus/*.csv); not delta-friendly in git
data/processed/corpus.parquet

# Sentence-BERT embedding cache (regenerable)
data/similarity/embeddings.parquet

# Fine-tuned model weights (rebuilt by src.skillmodel.train)
models/
